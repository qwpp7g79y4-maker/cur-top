<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses</title>
<style>
body{font:15px/1.5 system-ui,sans-serif;max-width:960px;margin:0 auto;padding:24px}
pre{background:#f4f4f4;padding:12px;white-space:pre-wrap;font-size:13px}
.license{border-top:1px solid #ddd;margin-top:24px}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>cur-top contains the following third-party Rust crates. Their license texts follow.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<div class="license">
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by:</h4>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</div>
{{/each}}
</body>
</html>
